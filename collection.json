        {
          "name": "Get Product List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// تست کد وضعیت ۲۰۰\r",
                  "pm.test(\"دریافت موفقیت‌آمیز محصولات\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// چک کردن اینکه آیا لیست محصولات پر است یا نه\r",
                  "pm.test(\"لیست محصولات خالی نیست\", function () {\r",
                  "    var responseData = pm.response.json();\r",
                  "    pm.expect(responseData.data.length).to.be.above(0);\r",
                  "});\r",
                  "// ۳. تعریف قرارداد استاندارد (Schema) برای لیست محصولات\r",
                  "const schema = {\r",
                  "    type: \"object\",\r",
                  "    required: [\"page\", \"per_page\", \"total\", \"data\"],\r",
                  "    properties: {\r",
                  "        page: { type: \"number\" },\r",
                  "        per_page: { type: \"number\" },\r",
                  "        total: { type: \"number\" },\r",
                  "        data: {\r",
                  "            type: \"array\",\r",
                  "            items: {\r",
                  "                type: \"object\",\r",
                  "                required: [\"id\", \"name\", \"year\"],\r",
                  "                properties: {\r",
                  "                    id: { type: \"number\" },\r",
                  "                    name: { type: \"string\" },\r",
                  "                    year: { type: \"number\" }\r",
                  "                }\r",
                  "            }\r",
                  "        }\r",
                  "    }\r",
                  "};\r",
                  "\r",
                  "// بررسی کل ساختار پاسخ در یک خط با Schema\r",
                  "pm.test(\"ساختار و نوع داده‌های JSON باید مطابق قرارداد (Schema) باشد\", function () {\r",
                  "    pm.response.to.have.jsonSchema(schema);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
